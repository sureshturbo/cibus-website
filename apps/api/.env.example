// apps/api/.env.example -- copy to .env and fill in real values.

NODE_ENV=development

PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# MySQL 8:  mysql://user:pass@localhost:3306/cibus
# MariaDB:  mysql://user:pass@localhost:3306/cibus
DATABASE_URL=mysql://cibus:change-me@localhost:3306/cibus
# Optional: enables `prisma migrate dev` drift detection without touching live data.
SHADOW_DATABASE_URL=mysql://cibus:change-me@localhost:3306/cibus_shadow

# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=https://cibus.example,https://www.cibus.example
TRUST_PROXY=true

UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
SERVE_UPLOADS=true

LOG_LEVEL=info

SEED_ADMIN_EMAIL=admin@cibus.example
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Cibus Administrator

COMPANY_NAME=Cibus Trading
COMPANY_EMAIL=hello@cibus.example
COMPANY_PHONE=+91 00000 00000
COMPANY_ADDRESS=Full registered business address
INVOICE_PREFIX=INV
CURRENCY=INR

# Storefront capabilities, surfaced by GET /api/public/config.
OFFER_CODES_ENABLED=true
# Must stay false: orders are placed against a signed-in account. Guest carts are
# still allowed and merge into the account at sign-in.
GUEST_CHECKOUT_ENABLED=false
MAX_QUANTITY_PER_LINE=100