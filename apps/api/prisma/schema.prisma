// Prisma schema for Cibus Trading.
//
// Money convention: all monetary columns are integers holding MINOR UNITS
// (paise). Never a float, never a Prisma Decimal - integers are exact and
// JSON-safe. See packages/shared/src/money.ts.
//
// Product and customer details are snapshotted onto order_items and orders so
// historical invoices stay accurate after the catalogue or a profile is edited.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/* ========================================================================== */
/* Identity                                                                    */
/* ========================================================================== */

model Admin {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(120)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  stockMovements StockMovement[]
  sessions       RefreshSession[]

  @@map("admins")
}

model Customer {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(120)
  phone         String?   @db.VarChar(24)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  sessions  RefreshSession[]

  @@index([isActive])
  @@map("customers")
}

model Address {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  label       String   @default("Default") @db.VarChar(40)
  fullName    String   @map("full_name") @db.VarChar(120)
  phone       String   @db.VarChar(24)
  line1       String   @db.VarChar(200)
  line2       String?  @db.VarChar(200)
  city        String   @db.VarChar(80)
  state       String   @db.VarChar(80)
  postalCode  String   @map("postal_code") @db.VarChar(12)
  landmark    String?  @db.VarChar(200)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

/**
 * Refresh tokens are stored server-side so a session can be revoked immediately.
 * Access tokens stay short-lived and stateless.
 */
model RefreshSession {
  id          Int       @id @default(autoincrement())
  customerId  Int?      @map("customer_id")
  adminId     Int?      @map("admin_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([adminId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/* ========================================================================== */
/* Catalogue                                                                   */
/* ========================================================================== */

model Category {
  id          Int      @id @default(autoincrement())
  parentId    Int?     @map("parent_id")
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String   @default("") @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  offers   Offer[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                 Int      @id @default(autoincrement())
  categoryId         Int      @map("category_id")
  name               String   @db.VarChar(200)
  slug               String   @unique @db.VarChar(220)
  sku                String   @unique @db.VarChar(64)
  shortDescription   String   @default("") @map("short_description") @db.VarChar(300)
  description        String   @default("") @db.Text
  unitLabel          String   @default("unit") @map("unit_label") @db.VarChar(32)

  /// Integer paise. Repricing a product never alters historical order lines.
  price              Int      @db.Int
  compareAtPrice     Int?     @map("compare_at_price") @db.Int

  /// Cached authoritative total derived from the stock ledger. Updated in the
  /// same transaction as every ledger write; never edited directly.
  stockQuantity      Int      @default(0) @map("stock_quantity") @db.Int
  lowStockThreshold  Int      @default(5) @map("low_stock_threshold") @db.Int
  allowBackorder     Boolean  @default(false) @map("allow_backorder")

  isActive    Boolean @default(true) @map("is_active")
  isFeatured  Boolean @default(false) @map("is_featured")
  deletedAt   DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  offers         Offer[]

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([isActive, isFeatured])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String   @db.VarChar(500)
  altText   String   @default("") @map("alt_text") @db.VarChar(200)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/**
 * Append-only inventory ledger. A mutable quantity column alone cannot answer
 * "what did we hold last Tuesday" or "who reduced this by six"; this can, by
 * summing. products.stockQuantity is a cache kept in step with this table.
 */
model StockMovement {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  type           StockMovementType
  quantityChange Int      @map("quantity_change") @db.Int
  balanceAfter   Int      @map("balance_after") @db.Int
  referenceType  String   @default("MANUAL") @map("reference_type") @db.VarChar(24)
  referenceId    String?  @map("reference_id") @db.VarChar(64)
  note           String   @default("") @db.VarChar(500)
  createdById    Int?     @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy Admin?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

/* ========================================================================== */
/* Offers                                                                      */
/* ========================================================================== */

model Offer {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(120)
  code            String?   @unique @db.VarChar(40)
  type            OfferType
  /// Basis points when type = PERCENTAGE (1250 = 12.50%); paise when FIXED_AMOUNT.
  value           Int       @db.Int
  scope           OfferScope
  categoryId      Int?      @map("category_id")
  productId       Int?      @map("product_id")
  /// Integer paise. 0 means no minimum.
  minOrderAmount  Int       @default(0) @map("min_order_amount") @db.Int
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime  @map("ends_at")
  usageLimit      Int?      @map("usage_limit") @db.Int
  usageCount      Int       @default(0) @map("usage_count") @db.Int
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  redemptions OfferRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@index([scope, categoryId])
  @@index([scope, productId])
  @@index([startsAt, endsAt])
  @@map("offers")
}

model OfferRedemption {
  id        Int      @id @default(autoincrement())
  offerId   Int      @map("offer_id")
  orderId   Int      @map("order_id")
  discount  Int      @db.Int
  createdAt DateTime @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([offerId, orderId])
  @@index([offerId])
  @@map("offer_redemptions")
}

/* ========================================================================== */
/* Cart                                                                        */
/* ========================================================================== */

/// `token` serves guest carts; `customerId` serves authenticated carts. Only
/// product identity and quantity are stored - all pricing is derived.
model Cart {
  id         Int      @id @default(autoincrement())
  token      String?  @unique @db.VarChar(64)
  customerId Int?     @map("customer_id")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int      @db.Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

/* ========================================================================== */
/* Orders                                                                      */
/* ========================================================================== */

model Order {
  id           Int      @id @default(autoincrement())
  /// Human-readable sequential reference shown to the customer.
  orderNumber  String   @unique @map("order_number") @db.VarChar(32)
  customerId   Int?     @map("customer_id")
  status       OrderStatus @default(PENDING)
  fulfilmentMethod FulfilmentMethod @default(DELIVERY) @map("fulfilment_method")

  /// Customer details snapshotted at purchase time so a later profile edit or
  /// account deletion cannot rewrite history.
  customerName  String  @map("customer_name") @db.VarChar(120)
  customerEmail String  @map("customer_email") @db.VarChar(255)
  customerPhone String  @map("customer_phone") @db.VarChar(24)

  addressLine1  String  @map("address_line1") @db.VarChar(200)
  addressLine2  String? @map("address_line2") @db.VarChar(200)
  addressCity   String  @map("address_city") @db.VarChar(80)
  addressState  String  @map("address_state") @db.VarChar(80)
  addressPostalCode String @map("address_postal_code") @db.VarChar(12)
  addressLandmark   String? @map("address_landmark") @db.VarChar(200)

  /// Integer paise throughout. No tax column: tax processing is out of scope
  /// and can be added later without restructuring this table.
  subtotal      Int @db.Int
  discountTotal Int @default(0) @map("discount_total") @db.Int
  total         Int @db.Int

  deliveryNotes String  @default("") @map("delivery_notes") @db.VarChar(500)
  stockCommittedAt DateTime? @map("stock_committed_at")

  confirmedAt DateTime? @map("confirmed_at")
  deliveredAt DateTime? @map("delivered_at")
  cancelledAt DateTime? @map("cancelled_at")
  cancelReason String? @map("cancel_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  invoices      Invoice[]
  payments      Payment[]
  redemptions   OfferRedemption[]
  idempotencyKeys IdempotencyKey[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// Product identity and price are frozen here at purchase time. This is what
/// makes an invoice three catalogue generations later still correct.
model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  /// Nullable so a deleted product does not cascade away order history.
  productId       Int?     @map("product_id")
  productName     String   @map("product_name") @db.VarChar(200)
  productSlug     String   @map("product_slug") @db.VarChar(220)
  sku             String   @db.VarChar(64)
  unitLabel       String   @map("unit_label") @db.VarChar(32)
  unitPrice       Int      @map("unit_price") @db.Int
  quantity        Int      @db.Int
  lineDiscount    Int      @default(0) @map("line_discount") @db.Int
  lineTotal       Int      @map("line_total") @db.Int
  offerId         Int?     @map("offer_id")
  offerName       String?  @map("offer_name") @db.VarChar(120)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         Int         @id @default(autoincrement())
  orderId    Int         @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus @map("to_status")
  note       String      @default("") @db.VarChar(500)
  changedBy  String      @default("system") @map("changed_by") @db.VarChar(120)
  createdAt  DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/**
 * Placeholder. Payment processing is out of scope for this build, so no gateway
 * is called. The shape exists so adding one later does not reshape `orders`.
 */
model Payment {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  amount            Int      @db.Int
  status            String   @default("PENDING") @db.VarChar(24)
  provider          String?  @db.VarChar(40)
  providerReference String?  @unique @map("provider_reference") @db.VarChar(120)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

/* ========================================================================== */
/* Invoicing                                                                   */
/* ========================================================================== */

model Invoice {
  id            Int      @id @default(autoincrement())
  /// Sequential per financial year, allocated inside the issuing transaction.
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(32)
  financialYear String   @map("financial_year") @db.VarChar(9)
  orderId       Int      @map("order_id")
  status        InvoiceStatus @default(DRAFT)
  /// Business details snapshot so a later config change cannot rewrite history.
  issuerName    String   @map("issuer_name") @db.VarChar(160)
  issuerAddress String   @map("issuer_address") @db.Text
  issuerEmail   String   @map("issuer_email") @db.VarChar(255)
  issuerPhone   String   @map("issuer_phone") @db.VarChar(24)

  subtotal      Int @db.Int
  discountTotal Int @default(0) @map("discount_total") @db.Int
  total         Int @db.Int

  issuedAt DateTime  @default(now()) @map("issued_at")
  dueAt    DateTime? @map("due_at")
  pdfPath  String?   @map("pdf_path") @db.VarChar(500)
  voidedAt DateTime? @map("voided_at")
  voidReason String? @map("void_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([financialYear, status])
  @@index([status, issuedAt])
  @@map("invoices")
}

/**
 * Locked counters that guarantee sequential, unique numbers for orders and
 * invoices. A row is locked with SELECT ... FOR UPDATE inside the same
 * transaction that inserts the record, so concurrent requests serialise and two
 * documents can never share a number.
 *
 * Rolled-back transactions leave gaps. That is deliberate: gaps are acceptable
 * in accounting, duplicate numbers are not.
 */
model SequenceCounter {
  id        Int      @id @default(autoincrement())
  /// Namespace, e.g. "ORDER" or "INVOICE".
  scope     String   @db.VarChar(16)
  /// Period key, e.g. "2026-27" for a financial year.
  period    String   @db.VarChar(16)
  lastValue Int      @default(0) @map("last_value") @db.Int
  prefix    String   @db.VarChar(8)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, period])
  @@map("sequence_counters")
}

/* ========================================================================== */
/* Leads                                                                       */
/* ========================================================================== */

model PartnerEnquiry {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  businessName String   @map("business_name") @db.VarChar(160)
  email        String   @db.VarChar(255)
  phone        String   @db.VarChar(24)
  message      String   @db.Text
  status       EnquiryStatus @default(NEW)
  notes        String   @default("") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("partner_enquiries")
}

/* ========================================================================== */
/* Idempotency                                                                 */
/* ========================================================================== */

/**
 * Guards against duplicate orders when a client retries a checkout request.
 * The first request's response is replayed for any repeat with the same key.
 */
model IdempotencyKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(100)
  scope       String    @default("checkout") @db.VarChar(40)
  orderId     Int?      @map("order_id")
  responseHash String?  @map("response_hash") @db.VarChar(64)
  status      String    @default("IN_PROGRESS") @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("idempotency_keys")
}

/* ========================================================================== */
/* Enums (MariaDB / MySQL native enums, mirrors packages/shared/src/domain.ts)  */
/* ========================================================================== */

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum OfferType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OfferScope {
  ALL_PRODUCTS
  CATEGORY
  PRODUCT
}

enum FulfilmentMethod {
  DELIVERY
  PICKUP
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}